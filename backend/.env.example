# Copy to backend/.env and fill in. backend/.env is git-ignored; never commit it.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# True for local development only.
DEBUG=True

# Comma-separated hosts this server answers to.
ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://user:password@host:port/dbname
DATABASE_URL=postgres://davidbane@localhost:5432/davidbane
